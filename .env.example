# Anthropic API Key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JobTread Grant Key — create at https://app.jobtread.com/grants
JOBTREAD_GRANT_KEY=your_jobtread_grant_key_here

# Simple passphrase to protect the web UI from public access
APP_SECRET_KEY=change_this_to_a_random_string

# Your company info (used in document signatures)
COMPANY_NAME=DRX Roofing & General Contracting
COMPANY_LICENSE=FL CGC#000000
COMPANY_PHONE=(555) 000-0000
COMPANY_EMAIL=office@yourdomain.com
COMPANY_ADDRESS=123 Main St, City, FL 00000
